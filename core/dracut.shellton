PKG_NAME="dracut"
PKG_PRETTY="Dracut"
PKG_DESC="Modular initramfs generation tool"
PKG_VER="059"
PKG_URL="https://github.com/dracutdevs/dracut/archive/refs/tags/${PKG_VER}.tar.gz"
BUILD_DEPENDS="glibc-libbundle kmod-libbundle util-linux-libbundle linux asciidoc"

FLAG_PREPACKAGED=1
FLAG_COREPACKAGE=1

update() {
    latest_tag=$(curl -s https://api.github.com/repos/dracutdevs/dracut/releases/latest | grep -oP '"tag_name":\s*"\K[^"]+')
    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
        FLAG_OOD=1
        sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    # Dracut uses a traditional configure script
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --libdir=/usr/lib

    make -j$(nproc)
    make DESTDIR="$PKG_DEST_DIR" install

    # Ensure standard dracut directories exist in the package structure
    mkdir -p "$PKG_DEST_DIR/var/lib/dracut"
    mkdir -p "$PKG_DEST_DIR/etc/dracut.conf.d"
}