PKG_NAME="procps-ng"
PKG_PRETTY="Procps-ng"
PKG_DESC="Standard system process monitoring utilities"
PKG_VER="4.0.7"
PKG_URL="https://gitlab.com/procps-ng/procps.git"

BUILD_DEPENDS="glibc ncurses"

FLAG_GIT=1
FLAG_SYSPACKAGE=1
FLAG_SYSPACKAGE_INSTALL_ROOT=1

# Functions

update() {
    latest_tag=$(git ls-remote --tags --refs "https://gitlab.com/procps-ng/procps.git" \
        | awk -F/ '{print $NF}' \
        | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' \
        | sed 's/^v//' \
        | sort -V \
        | tail -n 1)

    echo "Latest tagged release: $latest_tag"

    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
        FLAG_OOD=1
        sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    ./autogen.sh
    ./configure \
        --prefix=/usr \
        --bindir=/usr/bin \
        --sbindir=/usr/bin \
        --disable-static \
        --disable-kill

    make -j$(nproc)

    make install DESTDIR="$PKG_DEST_DIR"
}
