PKG_NAME="systemd"
PKG_PRETTY="systemd"
PKG_DESC="Core Init System including Runtime Dependencies"
PKG_VER="v262.1"
PKG_URL="https://github.com/systemd/systemd.git"

BUILD_DEPENDS="glibc-libbundle linux-headers-libbundle libcap-libbundle util-linux-libbundle kmod-libbundle libelf-libbundle libbpf-libbundle libgcrypt-libbundle pcre2-libbundle libidn2-libbundle lz4-libbundle zstd-libbundle"

FLAG_GIT=1
FLAG_COREPACKAGE=1

# Functions

update() {
    latest_tag=$(git ls-remote --tags --refs "$PKG_URL" | awk -F/ '{print $NF}' | sort -V | tail -n 1)
    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
       FLAG_OOD=1
       sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    export PKG_CONFIG_PATH="${SYSLIB_PATH}/usr/lib/pkgconfig:${SYSLIB_PATH}/usr/share/pkgconfig"
    export CPPFLAGS="-I${SYSLIB_PATH}/usr/include"
    export LDFLAGS="-L${SYSLIB_PATH}/usr/lib"

    local _timeservers=(time.cloudflare.com)
    local _nameservers=(
      '9.9.9.9#dns.quad9.net'
      '2620:fe::9#dns.quad9.net'
      '1.1.1.1#cloudflare-dns.com'
      '2606:4700:4700::1111#cloudflare-dns.com'
      '8.8.8.8#dns.google'
      '2001:4860:4860::8888#dns.google'
    )

    local _meson_options=(
        --prefix=/usr
	--sysconfdir=/etc
	--localstatedir=/var
        -Dversion-tag="${PKG_VER}-LiraOS"
        -Dvcs-tag=false
        -Dshared-lib-tag="${PKG_VER}"
        -Dmode=release
        -Dapparmor=disabled
        -Dselinux=disabled
        -Dbootloader=enabled
        -Dxenctrl=disabled
        -Dbpf-framework=enabled
        -Dima=false
        -Dlibidn2=enabled
        -Dlz4=enabled
        -Dsysupdated=enabled
        -Dcompat-sysv-interfaces=false
        -Ddefault-dnssec=no
        -Ddefault-kill-user-processes=false
        -Dfallback-hostname='lira-os'
        -Dntp-servers="${_timeservers[*]}"
        -Ddns-servers="${_nameservers[*]}"
        -Drpmmacrosdir=no
        -Dsbat-distro='lira-os'
        -Dsbat-distro-summary='Lira OS'
        -Dsbat-distro-version="${PKG_VER}"
        -Dsbat-distro-pkgname="${PKG_NAME}"
    )

    # Compile systemd
    meson setup build "${_meson_options[@]}"
    meson compile -C build
    DESTDIR="$PKG_DEST_DIR" meson install -C build
}
