PKG_NAME="bash"
PKG_PRETTY="Bash"
PKG_DESC="GNU Bourne Again SHell"
PKG_VER="5.3"
PKG_URL="https://ftp.gnu.org/gnu/bash/bash-${PKG_VER}.tar.gz"
BUILD_DEPENDS="glibc-libbundle ncurses-libbundle"

FLAG_PREPACKAGED=1
FLAG_SYSPACKAGE=1

# Functions

update() {
    latest_tag=$(curl -s "https://ftp.gnu.org/gnu/bash/" | grep -oP 'bash-[0-9]+\.[0-9]+(\.[0-9]+)?\.tar\.gz' | sed 's/bash-//;s/\.tar\.gz//' | sort -V | tail -n 1)
    echo "Latest tagged release: $latest_tag"
    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
       FLAG_OOD=1
       sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    export PKG_CONFIG_PATH="${SHELLTON_SYSLIB_DIR}/usr/lib/pkgconfig"
    export CFLAGS="-I${SHELLTON_SYSLIB_DIR}/include -Wno-implicit-function-declaration -Wno-int-conversion"
    export LDFLAGS="-L${SHELLTON_SYSLIB_DIR}/lib"

    _build_flags=(
	--prefix="/opt/syspackages/${PKG_NAME}-${PKG_VER}"
	--without-bash-malloc
    )

    ./configure "${_build_flags[@]}"

    make -j$(nproc)

    make install DESTDIR="$PKG_DEST_DIR"

}