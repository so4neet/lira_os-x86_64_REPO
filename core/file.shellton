PKG_NAME="file"
PKG_PRETTY="File"
PKG_DESC="File type identification utility"
PKG_VER="5.48"
PKG_URL="https://github.com/file/file.git"

BUILD_DEPENDS="git"

FLAG_GIT=1
FLAG_SYSPACKAGE=1
FLAG_SYSPACKAGE_INSTALL_ROOT=1

# Functions

update() {
    latest_tag=$(git ls-remote --tags --refs ${PKG_URL} | awk -F/ '{print $NF}' | grep -E '^FILE[0-9]+_[0-9]+' | sed 's/^FILE//;s/_/./g' | sort -V | tail -n 1)
    echo "Latest tagged release: $latest_tag"
    if [ -n "$latest_tag" ]; && [ "$latest_tag != "$PKG_VER" ]; then
       FLAG_OOD=1
       sed -i 's/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {

    _build_flags=(
	--prefix=/usr
	--datadir=/usr/share/file
	--enable-fsect-man5
	--enable-libseccomp
    )

    ./configure "${_build_flags[@]}"

    make -j$(nproc)

    make install DESTDIR="$PKG_DEST_DIR"
}