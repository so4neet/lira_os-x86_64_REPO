PKG_NAME="coreutils"
PKG_PRETTY="Coreutils"
PKG_DESC="Basic file, shell and text manipulation utilities of the GNU operating system"
PKG_VER="9.12"
PKG_URL="https://ftp.gnu.org/gnu/coreutils/coreutils-${PKG_VER}.tar.gz"
BUILD_DEPENDS="glibc-libbundle acl-libbundle attr-libbundle ncurses-libbundle gmp-libbundle readline-libbundle openssl-libbundle"

FLAG_PREPACKAGED=1
FLAG_SYSPACKAGE=1
FLAG_SYSPACKAGE_INSTALL_ROOT=1

# Functions

update() {
    latest_tag=$(curl -s "https://ftp.gnu.org/gnu/coreutils/" | grep -oP 'coreutils-[0-9]+\.[0-9]+(\.[0-9]+)?\.tar\.gz' | sed 's/coreutils-//;s/\.tar\.gz//' | sort -V | tail -n 1)
    echo "Latest tagged release: $latest_tag"
    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
       FLAG_OOD=1
       sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    export PKG_CONFIG_PATH="${SYSLIB_PATH}/usr/lib/pkgconfig"
    export CFLAGS="-I${SYSLIB_PATH}/include"
    export LDFLAGS="-L${SYSLIB_PATH}/lib"

    _build_flags=(
	--prefix="/opt/syspackages/${PKG_NAME}-${PKG_VER}"
	--enable-install-program=hostname
	--libexecdir="/opt/syspackages/${PKG_NAME}-${PKG_VER}/lib/coreutils"
	--enable-no-install-program=kill,uptime
        --with-openssl
    )
    
    ./configure "${_build_flags[@]}"
    make -j$(nproc) HELP2MAN=true
    make install DESTDIR="$PKG_DEST_DIR" HELP2MAN=true
}