PKG_NAME="bzip2"
PKG_PRETTY="bzip2"
PKG_DESC="File compression library"
PKG_VER="latest"
PKG_URL="https://sourceware.org/pub/bzip2/bzip2-latest.tar.gz"

BUILD_DEPENDS="glibc"

FLAG_PREPACKAGED=1
FLAG_SYSPACKAGE=1
FLAG_SYSPACKAGE_INSTALL_ROOT=1

# Functions

update() {
    echo "Bzip2 hosts a -latest, fetch that"
    FLAG_OOD=1
}

build() {
    # Ensure relative symbolic links are used
    sed -i 's@\(ln -s -f \)$(PREFIX)/bin/@\1@' Makefile

    make -f Makefile-libbz2_so -j$(nproc)
    make clean
    make -j$(nproc)
    make PREFIX="$PKG_DEST_DIR/usr" install"
    mkdir -p "$PKG_DEST_DIR/usr/lib" "$PKG_DEST_DIR/usr/bin"
    cp -av libbz2.so.* "$PKG_DEST_DIR/usr/lib/"
    ln -sf libbz2.so.1.0.8 "$PKG_DEST_DIR/usr/lib/libbz2.so"
    ln -sf libbz2.so.1.0.8 "$PKG_DEST_DIR/usr/lib/libbz2.so.1"

    cp -v bzip2-shared "$PKG_DEST_DIR/usr/bin/bzip2"
    ln -sf bzip2 "$PKG_DEST_DIR/usr/bin/bunzip2"
    ln -sf bzip2 "$PKG_DEST_DIR/usr/bin/bzcat"
}