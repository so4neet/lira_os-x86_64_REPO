PKG_NAME="lira-base"
PKG_PRETTY="LiraOS Base"
PKG_DESC="The base filesystem for Lira OS"
PKG_VER="0.1"
PKG_URL="https://github.com/so4neet/lira-base.git"

BUILD_DEPENDS="cowsay"

FLAG_GIT=1
FLAG_COREPACKAGE=1
FLAG_LIRA_LOWLEVEL=1

# Functions

update() {
    echo "Always re-fetch"
    FLAG_OOD=1
}

build() {    
    tar -czf "$PKG_NAME".syspackage -C .
    echo "LiraOS!" | cowsay
}