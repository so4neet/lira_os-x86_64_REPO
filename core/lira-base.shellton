PKG_NAME="lira-base"
PKG_PRETTY="LiraOS Base"
PKG_DESC="The base filesystem for Lira OS"
PKG_VER="0.1"
PKG_URL="https://github.com/so4neet/lira-base.git"

BUILD_DEPENDS="cowsay"

FLAG_GIT=1
FLAG_COREPACKAGE=1
FLAG_LIRA_LOWLEVEL=1

# Functions

update() {
    echo "Always re-fetch"
    FLAG_OOD=1
}

build() {
    echo "LiraOS!" | cowsay
    tar -xf lira-base.syspackage
    rm -rf lira-base.syspackage
    tar -I 'zstd --ultra -22' -cf lira-base.syspackage -C lira-system-syspackage/*
    cp lira-base.syspackage "$PKG_DEST_DIR"
}