PKG_NAME="psmisc"
PKG_PRETTY="Psmisc"
PKG_DESC="Small utilities that use the proc file-system"
PKG_VER="23.7"
PKG_URL="https://sourceforge.net/projects/psmisc/files/psmisc-${PKG_VER}.tar.xz"

BUILD_DEPENDS="glibc ncurses"

FLAG_PREPACKAGED=1
FLAG_SYSPACKAGE=1
FLAG_SYSPACKAGE_INSTALL_ROOT=1

# Functions

update() {
    latest_tag=$(git ls-remote --tags --refs "https://gitlab.com/psmisc/psmisc.git" \
        | awk -F/ '{print $NF}' \
        | grep -E '^v[0-9]+\.[0-9]+$' \
        | sed 's/^v//' \
        | sort -V \
        | tail -n 1)

    echo "Latest tagged release: $latest_tag"

    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
        FLAG_OOD=1
        sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    ./configure \
        --prefix=/usr

    make -j$(nproc)

    make install DESTDIR="$PKG_DEST_DIR"
}
