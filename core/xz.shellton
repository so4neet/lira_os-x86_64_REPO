PKG_NAME="xz"
PKG_PRETTY="XZ Utils"
PKG_DESC="Data compression library and command-line tools"
PKG_VER="v5.8.4"
PKG_URL="https://github.com/tukaani-project/xz.git"

BUILD_DEPENDS="glibc"

FLAG_GIT=1
FLAG_SYSPACKAGE=1
FLAG_SYSPACKAGE_INSTALL_ROOT=1

# Functions

update() {
    latest_tag=$(git ls-remote --tags --refs "$PKG_URL" | awk -F/ '{print $NF}' | sort -V | tail -n 1)
    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
       FLAG_OOD=1
       sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {

    _build_options=(
	--prefix=/usr
	--disable-static
    )
    ./configure "${_build_options[@]}"
    make -j$(nproc)
    make install DESTDIR="$PKG_DEST_DIR"
}