PKG_NAME="booster"
PKG_PRETTY="Booster"
PKG_DESC="Fast and lean initramfs generator"
PKG_VER="v0.13.0"
PKG_URL="https://github.com/anatol/booster.git"

BUILD_DEPENDS="go git"

FLAG_GIT=1
FLAG_SYSPACKAGE=1

update() {
    latest_tag=$(git ls-remote --tags --refs "$PKG_URL" | awk -F/ '{print $NF}' | sort -V | tail -n 1)
    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
       FLAG_OOD=1
       sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    export CGO_ENABLED=0
    go build -trimpath -ldflags="-s -w" -o booster-gen ./cmd/generator
    install -Dm755 booster-gen "$PKG_DEST_DIR/usr/bin/booster"
    if [ -f "docs/booster.yaml.example" ]; then
       install -Dm644 docs/booster.yaml.example "$PKG_DEST_DIR/etc/booster.yaml"
    fi
}