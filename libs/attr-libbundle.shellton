PKG_NAME="attr-libbundle"
PKG_VER="2.6.0"
PKG_URL="https://git.savannah.nongnu.org/git/attr.git"
BUILD_DEPENDS=""

FLAG_GIT=1
FLAG_LIB=1

# Functions

update() {
    latest_tag=$(git ls-remote --tags --refs "https://git.savannah.nongnu.org/git/acl.git" | awk -F/ '{print $NF}' | sed 's/^v//' | tail -n 1)
    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
       FLAG_OOD=1
       sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    ./autogen.sh
    ./configure
    make -j$(nproc)
    make install DESTDIR="${PKG_DEST_DIR}"
}