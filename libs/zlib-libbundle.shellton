PKG_NAME="zlib-libbundle"
PKG_VER="1.3.1"
PKG_URL="https://github.com/madler/zlib/releases/download/v${PKG_VER}/zlib-${PKG_VER}.tar.gz"

BUILD_DEPENDS="glibc-libbundle"

FLAG_PREPACKAGED=1
FLAG_LIB=1

update() {
    latest_tag=$(curl -s https://api.github.com/repos/madler/zlib/releases/latest | grep -oP '"tag_name":\s*"v\K[^"]+')
    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
        FLAG_OOD=1
        sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    ./configure --prefix=/usr
    make -j$(nproc)
    make DESTDIR="$PKG_DEST_DIR" install
}