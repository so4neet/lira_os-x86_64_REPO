PKG_NAME="kmod-libbundle"
PKG_VER="v34.2"
PKG_URL="https://www.kernel.org/pub/linux/utils/kernel/kmod/kmod-${PKG_VER}.tar.xz"
BUILD_DEPENDS="glibc-libbundle"

FLAG_PREPACKAGED=1
FLAG_LIB=1

update() {
  latest_tag=$(curl -s https://www.kernel.org/pub/linux/utils/kernel/kmod/ | grep -oP 'kmod-\K[0-9]+(\.[0-9]+)?' | sort -V | tail -n 1)
  if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
    FLAG_OOD=1
    sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
  fi
}

build() {
  _build_options=(
    --prefix=/usr
    --libdir=/usr/lib
    --with-zstd
    --with-xz
    --disable-manpages
  )
  
  ./configure "${_build_options[@]}"
  make -j$(nproc)
  make DESTDIR="$PKG_DEST_DIR" install
}
