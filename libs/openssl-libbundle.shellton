PKG_NAME="openssl-libbundle"
PKG_VER="4.0.3"
PKG_URL="https://github.com/openssl/openssl.git"
BUILD_DEPENDS="glibc-libbundle"

FLAG_GIT=1
FLAG_LIB=1

# Functions

update() {
    latest_tag=$(git ls-remote --tags --refs "https://github.com/openssl/openssl.git" | awk -F/ '{print $NF}' | sed 's/^openssl-//' | grep -E '[0-9].[0-9].[0-9]'  |grep -E -v '(beta|alpha)' | tail -n 1)
    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
       FLAG_OOD=1
       sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    export PKG_CONFIG_PATH="${SYSLIB_PATH}/usr/lib/pkgconfig"
    export CFLAGS="-I${SYSLIB_PATH}/include"
    export LDFLAGS="-L${SYSLIB_PATH}/lib"
    
    ./Configure --prefix=/usr --libdir=/lib --openssldir=/etc/ssl shared zlib-dynamic
    make -j$(nproc)
    make install_sw DESTDIR="$PKG_DEST_DIR"
}