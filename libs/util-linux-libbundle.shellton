PKG_NAME="util-linux-libbundle"
PKG_PRETTY="util-linux"
PKG_DESC="Linux utilities"
PKG_VER="v2.42.4"
PKG_URL="https://github.com/util-linux/util-linux.git"

BUILD_DEPENDS="glibc-libbundle"

FLAG_GIT=1
FLAG_LIB=1

# Functions

update() {
    latest_tag=$(git ls-remote --tags --refs "$PKG_URL" | awk -F/ '{print $NF}' | grep -E -v '(devel)' | sort -V | tail -n 1)
    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
       FLAG_OOD=1
       sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    _build_options=(
	--prefix=/usr
	--libdir=/usr/lib
	--disable-all-programs
	--enable-libmount
	--enable-libblkid
	--enable-libuuid
	--disable-wall
	--disable-su
	--disable-sulogin
	--disable-login
    )
    ./autogen.sh
    ./configure "${_build_options[@]}"
    make -j$(nproc)
    make install DESTDIR="$PKG_DEST_DIR"
}