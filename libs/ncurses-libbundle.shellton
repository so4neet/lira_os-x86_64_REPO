PKG_NAME="ncurses-libbundle"
PKG_VER="6.4"
PKG_URL="https://github.com/mirror/ncurses.git"
BUILD_DEPENDS=""

FLAG_GIT=1
FLAG_LIB=1

# Functions

update() {
    latest_tag=$(git ls-remote --tags --refs "https://github.com/mirror/ncurses.git" | awk -F/ '{print $NF}' | sed 's/^v//' | tail -n 1)
    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
       FLAG_OOD=1
       sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    ./configure
    make -j$(nproc)
    make install DESTDIR="${PKG_DEST_DIR}"
}