PKG_NAME="libcap"
PKG_VER="2.78"
PKG_URL="https://git.kernel.org/pub/scm/libs/libcap/libcap.git"
BUILD_DEPENDS="git go linux-api-headers"

FLAG_GIT=1
FLAG_LIB=1

# Functions

update() {
    latest_tag=$(git ls-remote --tags --refs "https://git.kernel.org/pub/scm/libs/libcap/libcap.git" | awk -F/ '{print $NF}' | grep -E 'libcap-[0-9].[0-9]{2}' | sed 's/^sig-//' | sed 's/^libcap-//' | tail -n 1)
    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
       FLAG_OOD=1
       sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    make
    make install DESTDIR="${PKG_WORK_DIR}"
}