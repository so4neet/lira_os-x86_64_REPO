PKG_NAME="lz4-libbundle"
PKG_VER="1.10.0"
PKG_URL="https://github.com/lz4/lz4/archive/refs/tags/v${PKG_VER}.tar.gz"
BUILD_DEPENDS="glibc-libbundle"

FLAG_PREPACKAGED=1
FLAG_LIB=1

update() {
    latest_tag=$(curl -s https://api.github.com/repos/lz4/lz4/releases/latest | grep -oP '"tag_name":\s*"v\K[^"]+')
    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
        FLAG_OOD=1
        sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    make prefix=/usr libdir=/lib
    make prefix=/usr libdir=/lib DESTDIR="$PKG_DEST_DIR" install
}