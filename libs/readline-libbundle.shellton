PKG_NAME="readline-libbundle"
PKG_VER="8.3"
PKG_URL="https://ftp.gnu.org/gnu/readline/readline-${PKG_VER}.tar.gz"
BUILD_DEPENDS=""

FLAG_PREPACKAGED=1
FLAG_LIB=1

# Functions

update() {
    latest_tag=$(curl -s "https://ftp.gnu.org/gnu/readline/" | grep -oP 'readline-[0-9]+\.[0-9]+(\.[0-9]+)?\.tar\.gz' | sed 's/readline-//;s/\.tar\.gz//' | sort -V | tail -n 1)
    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
       FLAG_OOD=1
       sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    export CPPFLAGS="-I${SYSLIB_PATH}/include -I${SYSLIB_PATH}/include/ncursesw"
    export CFLAGS="-I${SYSLIB_PATH}/include -I${SYSLIB_PATH}/include/ncursesw"
    export LDFLAGS="-L${SYSLIB_PATH}/lib"
    export LD_LIBRARY_PATH="${SYSLIB_PATH}/lib"
    
    _build_options=(
	--prefix=/usr
	--with-shared
	--with-curses
        --disable-static
    )
    ./configure
    make SHLIB_LIBS="-lncursesw -ltinfow" -j$(nproc)
    make install DESTDIR="${PKG_DEST_DIR}" SHLIB_LIBS="-lncursesw -ltinfow"
}