PKG_NAME="gmp-libbundle"
PKG_VER="gmp-6.1.0"
PKG_URL="https://github.com/gmp-mirror/gmp.git"
BUILD_DEPENDS=""

FLAG_GIT=1
FLAG_LIB=1

# Functions

update() {
    latest_tag=$(git ls-remote --tags --refs "https://github.com/gmp-mirror/gmp.git" | awk -F/ '{print $NF}' | grep -E -v '(rel|FUNKY)' | tail -n 1)
    if [ -n "$latest_tag" ] && [ "$latest_tag" != "$PKG_VER" ]; then
       FLAG_OOD=1
       sed -i "s/^PKG_VER=.*/PKG_VER=\"$latest_tag\"/" "$ST_PATH"
    fi
}

build() {
    git checkout "${PKG_VER}"	# Needed for automake
    ./.bootstrap
    ./configure
    make -j$(nproc)
    make install DESTDIR="${PKG_DEST_DIR}"
}